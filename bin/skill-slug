#!/usr/bin/env bash
# skill-slug — output project slug and sanitized branch name
# Usage: eval "$(skill-slug)"  → sets SLUG and BRANCH variables
# Or:    skill-slug            → prints SLUG=... and BRANCH=... lines
#
# The slug ALGORITHM is preserved byte-for-byte from the implementation this
# replaced, so that project directories already on disk keep matching. Change
# the algorithm and every accumulated learning silently detaches from its
# project.
#
# Security: output is sanitized to [a-zA-Z0-9._-] only, preventing shell
# injection when consumed via `source` or `eval`.
set -euo pipefail

SKILLS_HOME="${SKILLS_HOME:-$HOME/.skills}"
CACHE_DIR="$SKILLS_HOME/slug-cache"
PROJECT_DIR="$(pwd)"
# Encode absolute path as cache key: /Users/j/foo → _Users_j_foo
CACHE_KEY=$(printf '%s' "$PROJECT_DIR" | tr '/' '_')
CACHE_FILE="${CACHE_DIR}/${CACHE_KEY}"

# slug_from_remote <remote-name> -- echoes the owner-repo slug, or nothing.
slug_from_remote() {
  local url raw
  url=$(git remote get-url "$1" 2>/dev/null) || return 0
  [[ -n "$url" ]] || return 0
  raw=$(printf '%s' "$url" | sed 's|.*[:/]\([^/]*/[^/]*\)\.git$|\1|;s|.*[:/]\([^/]*/[^/]*\)$|\1|' | tr '/' '-')
  printf '%s' "$raw" | tr -cd 'a-zA-Z0-9._-'
}

# compute_slug -- the remote-derived slug, or nothing when no remote resolves.
#
# `origin` is tried FIRST and its precedence must not change: every slug that
# resolves correctly today resolves through it, and this file's own header warns
# that changing the algorithm silently detaches accumulated learnings from their
# project. The names after it only ADD resolution where there was none, so no
# existing slug moves.
#
# They are needed because `origin` is not a safe assumption here: the canonical
# remote in this group's repos is routinely `official` (a personal fork is never
# a PR source), and agent-skills has no `origin` at all. Without this the next
# branch fell through to `basename "$PWD"` -- which is the WORKTREE directory
# name, so every feature worktree filed its learnings under a throwaway slug
# that died with the branch. ARC and Carmel each ended up quartered that way.
compute_slug() {
  local s name
  for name in origin official upstream; do
    s=$(slug_from_remote "$name")
    [[ -n "$s" ]] && { printf '%s' "$s"; return 0; }
  done
  # Exactly one remote under some other name is unambiguous; two or more is a
  # guess, and guessing wrong here splits a project's store in half.
  if [[ $(git remote 2>/dev/null | wc -l) -eq 1 ]]; then
    slug_from_remote "$(git remote 2>/dev/null)"
  fi
}

# 1. Try cached slug first (guarantees consistency across sessions)
if [[ -f "$CACHE_FILE" ]]; then
  SLUG=$(cat "$CACHE_FILE")
fi

# 2. Heal a cache poisoned by the origin-only era. A cached slug that is merely
#    this directory's basename, in a checkout where a remote DOES now resolve,
#    was written by the old fallback -- keep it and the directory stays pinned to
#    a dead slug forever. Narrow on purpose: an entry that does not look like the
#    basename is left alone, so a legitimately basename-shaped repo name is only
#    ever rewritten to the same value.
if [[ -n "${SLUG:-}" && "$SLUG" == "$(basename "$PWD" | tr -cd 'a-zA-Z0-9._-')" ]]; then
  HEALED=$(compute_slug)
  [[ -n "$HEALED" ]] && SLUG="$HEALED"
fi

# 3. If no cache, compute from the git remotes
if [[ -z "${SLUG:-}" ]]; then
  SLUG=$(compute_slug)
fi

# 4. Fallback to basename only when there's truly no git remote configured
SLUG="${SLUG:-$(basename "$PWD" | tr -cd 'a-zA-Z0-9._-')}"

# 3b. Re-sanitize unconditionally before the value is echoed into `eval`/`source`
#     output. The compute (2) and fallback (3) paths already filter, but a value
#     read straight from the cache file (1) does NOT — a poisoned
#     $SKILLS_HOME/slug-cache/<key> would otherwise inject shell into
#     `eval "$(skill-slug)"`. Filtering here honors the [a-zA-Z0-9._-] invariant
#     promised in the header on every path, and heals a poisoned cache on write (4).
SLUG=$(printf '%s' "$SLUG" | tr -cd 'a-zA-Z0-9._-')

# 4. Cache the slug for future sessions (atomic write, fail silently)
if [[ -n "$SLUG" ]]; then
  mkdir -p "$CACHE_DIR" 2>/dev/null || true
  CACHE_TMP=$(mktemp "$CACHE_DIR/.slug-XXXXXX" 2>/dev/null) || CACHE_TMP=""
  if [[ -n "$CACHE_TMP" ]]; then
    printf '%s' "$SLUG" > "$CACHE_TMP" && mv "$CACHE_TMP" "$CACHE_FILE" 2>/dev/null || rm -f "$CACHE_TMP" 2>/dev/null
  fi
fi

RAW_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || RAW_BRANCH=""
BRANCH=$(printf '%s' "${RAW_BRANCH:-}" | tr -cd 'a-zA-Z0-9._-')
BRANCH="${BRANCH:-unknown}"
echo "SLUG=$SLUG"
echo "BRANCH=$BRANCH"
