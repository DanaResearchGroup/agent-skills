# shellcheck shell=bash
# shellcheck disable=SC2154  # _tr_* globals are assigned by bin/track before this component runs
# _track_autoclose — the B2.1 auto-close pass of bin/track, split out as a
# sourced component (I25). Defines tr_ac_classify_close_failure, _TR_CLOSE_PY
# (which carries the REASONS registry) and the two stage entry points
# _tr_autoclose_prefetch / _tr_autoclose_pass; bin/track sources this file
# once, up front, and invokes the entry points at the original stage
# positions. Everything here runs in track's own shell: all variables and
# temp-file bookkeeping (_tr_mktemp manifest, traps) are track's globals.
# guard: sourced component of bin/track, never a program of its own
[[ "${BASH_SOURCE[0]}" != "$0" ]] || { echo "_track_autoclose: sourced component of bin/track; run bin/track instead" >&2; exit 2; }

# fix-pass-5b#2: classify pm_close_issue's captured stderr into one of the
# stable P3-4 reason tokens. Matches ONLY whole stderr LINES that _lib.sh
# itself emits with a `<token>: ...` prefix -- never a substring match over
# the raw blob (which embeds pm_apply's own output and could let a token
# forged mid-line, e.g. inside an echoed detail or filename, spoof a
# classification). Pure function, no side effects -- unit-testable in
# isolation by extracting just this definition.
tr_ac_classify_close_failure() {
  local blob="$1" reason="close/archive-failure" line
  while IFS= read -r line; do
    case "${line}" in
      close-refused-state-race:*) reason="close-race/refusal"; break ;;
      close-refused-unfoldable-log:*) reason="close-refused-unfoldable-log"; break ;;
    esac
  done <<<"${blob}"
  if [[ "${reason}" == "close/archive-failure" ]]; then
    while IFS= read -r line; do
      if [[ "${line}" == close-transition-durable:* ]]; then
        reason="closed-with-pending-archive"
        break
      fi
    done <<<"${blob}"
  fi
  printf '%s\n' "${reason}"
}

# ---------------------------------------------------------------------------
# Shared B2.1 auto-close python routines (STRICT merged-path only; the
# MARKER path is explicitly out of scope for B2.1 -- see header note above
# the auto-close stage below). Appended to (not merged into) _TR_CORROB_PY:
# concatenated ahead of it at call sites via `_TR_CORROB_PY`+`_TR_CLOSE_PY`,
# so `tr_run`/`tr_worktree_list`/BASE_SHA_RE/etc are already in scope.
# ---------------------------------------------------------------------------
read -r -d '' _TR_CLOSE_PY <<'PYEOF' || true
# ---------------------------------------------------------------------------
# REASONS (P3-9) -- the single registry of every surface-reason token the
# auto-close pass can emit, INCLUDING the ones minted by track's bash close
# loop / driver fallback rather than by this python (marked [bash]). Any
# new reason token MUST be added here; consumers (tests, operators grepping
# TRACKER.md) treat these strings as a stable contract.
# ---------------------------------------------------------------------------
REASONS = frozenset({
    # G1 -- issue state
    "issue-unregistered",
    "CLOSED-but-archive-leftovers",   # action=rearchive, not a refusal
    "NEEDS-USER",
    "BLOCKED",
    "paused/non-active",
    # G1.5 -- quarantine blast radius (constants shared with _lib.sh below)
    "invalid-question-state",
    "issue-related-quarantine",
    "quarantine-unattributable-blocks-autoclose",
    # G2 -- open questions
    "open-question-for-issue",
    "open-question-unscoped",
    # G3 -- dispatch graph
    "no-non-superseded-dispatch",
    "superseded-by-other-issue",
    "parent/child-roll-up-violation",
    "ABANDONED-without-same-issue-successor",
    "FAILED",
    "QUARANTINED",
    "dispatch-not-VERIFIED",
    # gate between G3 and G4 (P2-1(a): G4 never runs when disabled)
    "auto-close-disabled",
    # G4 -- strict git corroboration
    "repo-not-configured",
    "repo-not-on-disk",
    "missing-repo-metadata",
    "mainline-ref-not-configured",
    "mainline-ref-missing",
    "fetch-failed",
    "unreachable",
    "sha-malformed",
    "wrong-length",
    "replace-affected",
    "result==base",
    "result-not-descendant-of-base",
    "result-not-bound-to-branch",     # P2-2 branch-binding gate
    "no-strict-ancestry-and-no-valid-marker",
    # B2.2 -- per-repo marker-path config (fail-closed runtime validation)
    "repo-config-invalid",
    # B2.2 -- G4 marker arm (squash/rebase workflows)
    "marker-mismatch",
    "marker-merge-sha-unverified",
    "marker-merge-predates-dispatch",
    "marker-merge-not-on-mainline",
    "marker-branch-absent-uncorroborated",
    # [bash] fix-pass-6 F1: minted by track's close loop when the pre-close
    # audit-note emission fails -- the marker close is REFUSED (fail-closed:
    # no marker close without its durable provenance record) and retried
    # next tick. Listed purely for the registry; the python driver itself
    # never returns it.
    "marker-note-emit-failed",
    # B2.2 -- close-mode legibility tokens: carried as the `reason` of a
    # CLOSE row (action=close), so TRACKER.md and the audit trail always
    # distinguish a strict close from a marker (human-attested) close --
    # and the branch-deleted variant explicitly.
    "auto-closed-strict",
    "auto-closed-marker",
    "auto-closed-marker-branch-deleted",
    # driver failure paths
    "auto-close-driver-error",
    # [bash] minted by track's close loop from pm_close_issue's stable
    # stderr tokens (P3-4)
    "close-race/refusal",
    "close-refused-unfoldable-log",
    "close/archive-failure",
    "closed-with-pending-archive",   # rendered in the Auto-closed section
    # fix-pass-5b#3: registry-completeness -- these three tokens are real,
    # currently-emitted reason values from OTHER stages of the auto-close
    # pipeline (the stage-2 corroboration driver's record loop, and the AC
    # record-loop's standalone raced-write path). Neither of those call
    # sites has REASONS in scope today (they run _TR_CORROB_PY alone, or a
    # separate one-off python3 -c snippet, not concatenated with
    # _TR_CLOSE_PY) so the enforcement check above never actually sees
    # them -- they're listed here purely so REASONS stays the complete,
    # accurate registry of every reason token the auto-close pass can
    # surface, per P3-9's intent.
    "already-recorded",
    "corroboration-changed-under-lock",
    "raced-refused",
    # B3 -- auto-spawn stage (actionable rows)
    "spawn-ack-unconfirmed",
    "suspected-orphan-intent",
    # C4 -- exclusive spawn_intent lease: the engine refused our intent
    # because an OPEN intent (same or different ref) already holds the
    # (d, a) lease -- another process won it; do NOT spawn this tick.
    "lease-held-elsewhere",
    "herdr-tab-create-failed",
    "herdr-start-failed",
    "name-collision",
    "ambiguous-spawn-ack",
    "prompt-sha-mismatch",
    # B3 -- auto-spawn stage (fail-closed config skip; the spawn-stage
    # extension of the existing config-invalid pathway)
    "spawn-config-invalid",
    # B3 -- auto-spawn stage (steady-state counts)
    "capacity-exceeded",
    "auto-spawn-disabled",
    # B3 -- whole-plan-driver crash (loud degrade, mirrors
    # auto-close-driver-error)
    "spawn-driver-error",
})

# P3-9 cross-reference: templates/bin/_lib.sh's fold python defines these
# SAME two constants (same names, same values) where quarantine_by_issue is
# projected -- the G1.5 gate below keys on the exact strings the fold
# emits, so they must change in BOTH places or not at all.
REASON_INVALID_QUESTION_STATE = "invalid-question-state"
REASON_ISSUE_RELATED_QUARANTINE = "issue-related-quarantine"

CLOSEABLE_STATES = {"ACTIVE", "IN-PROGRESS"}
# Non-terminal dispatch states -- used by the cross-issue child_of roll-up
# gate below to decide whether a child dispatch is still "active" (anything
# short of the two TERMINAL states counts, matching _lib.sh's own
# TERMINAL = {VERIFIED, ABANDONED}).
TERMINAL_DISPATCH_STATES = {"VERIFIED", "ABANDONED"}




def tr_verify_commit(repo_path, sha, obj_format):
    # Returns (reason, None) on failure, else (None, sha). Shape check
    # (length-vs-object-format) BEFORE any git use of the value (mirrors
    # tr_corroborate_git's base_sha guard), then identity-anchored
    # `rev-parse --verify <sha>^{commit}` (a real object peels to itself; a
    # ref name peels to whatever it points at, so this also closes the
    # dynamic-ref bypass for a sha-shaped ref name).
    if not BASE_SHA_RE.match(sha or ""):
        return "sha-malformed", None
    expected_len = {"sha1": 40, "sha256": 64}.get(obj_format)
    if expected_len is None or len(sha) != expected_len:
        return "wrong-length", None
    rc, resolved, _ = tr_run(
        ["rev-parse", "--verify", "--end-of-options", sha + "^{commit}"], repo_path
    )
    if rc != 0 or resolved.strip() != sha:
        return "unreachable", None
    return None, sha


def tr_repo_has_grafts(repo_path):
    # GIT_NO_REPLACE_OBJECTS=1 (set by the caller around every git
    # invocation in this module) disables replace-REFS, but old-style
    # `.git/info/grafts` is a *separate* mechanism it does NOT neutralize --
    # detect it directly and refuse (fail-closed) rather than silently
    # trusting history that could be graft-rewritten.
    rc, path, _ = tr_run(["rev-parse", "--git-path", "info/grafts"], repo_path)
    if rc != 0:
        return True  # probe itself failed -- fail closed
    path = path.strip()
    if not path:
        return False
    full = path if os.path.isabs(path) else os.path.join(repo_path, path)
    try:
        return os.path.isfile(full) and os.path.getsize(full) > 0
    except OSError:
        return True


def tr_parse_fetch_ref(mainline, mainline_ref):
    # Shared shape validation for fetch-policy repos, used by BOTH track's
    # pre-lock pre-fetch phase (tr_prefetch_mainline_refs) and tr_g4_check
    # under the lock -- one predicate, so the two phases can never disagree
    # about which repos are fetchable. Returns the remote name, or None on
    # any shape failure. P3-1 (git argv hygiene): a leading-dash remote or
    # mainline segment is rejected outright -- a config value must never be
    # able to smuggle an option into git's argv -- on top of the
    # --end-of-options guard on the fetch invocation itself.
    if not mainline or not isinstance(mainline, str):
        return None
    if not isinstance(mainline_ref, str):
        return None
    m = re.match(r"^refs/remotes/([^/]+)/(.+)$", mainline_ref)
    if not m:
        return None
    remote = m.group(1)
    if remote.startswith("-") or mainline.startswith("-") or m.group(2).startswith("-"):
        return None
    return remote


def tr_prefetch_mainline_refs(repos):
    # P2-1(b): the pre-fetch phase, run by track BEFORE pm_lock is acquired
    # -- the ONLY place the auto-close pass ever touches the network. Each
    # configured fetch-policy repo's mainline ref is fetched at most once
    # per (repo,ref) per tick; returns {repo_name: "ok"|"fetch-failed"}.
    # Repos whose config shape fails tr_parse_fetch_ref are skipped here;
    # tr_g4_check re-derives the same verdict locally under the lock and
    # surfaces mainline-ref-missing for them (fail-closed either way).
    status = {}
    for name, entry in sorted((repos or {}).items()):
        if not isinstance(entry, dict):
            continue
        if entry.get("fetch_policy") != "fetch":
            continue
        repo_path = entry.get("path")
        mainline = entry.get("mainline")
        mainline_ref = entry.get("mainline_ref")
        remote = tr_parse_fetch_ref(mainline, mainline_ref)
        if not repo_path or remote is None:
            continue
        rc, _, _ = tr_run(
            ["fetch", "--end-of-options", remote,
             "+refs/heads/" + mainline + ":" + mainline_ref],
            repo_path,
        )
        status[name] = "ok" if rc == 0 else "fetch-failed"
    return status


def tr_branch_binding_state(run, result_sha, branch):
    # Shared P2-2 branch-binding probe (strict G4 + the marker arm; M2):
    # resolves refs/heads/<branch> and reports whether result_sha is its
    # tip or an ancestor of it (i.e. the commit actually lived on that
    # branch). Returns "bound" | "absent" | "unbound". refs/heads/ +
    # --end-of-options keep the index-sourced branch name inert in argv.
    rc, branch_tip, _ = run(
        ["rev-parse", "--verify", "--end-of-options", "refs/heads/" + branch + "^{commit}"]
    )
    if rc != 0:
        return "absent"
    branch_tip = branch_tip.strip()
    if branch_tip == result_sha:
        return "bound"
    rc, _, _ = run(["merge-base", "--is-ancestor", "--end-of-options", result_sha, branch_tip])
    return "bound" if rc == 0 else "unbound"


def tr_resolve_mainline(run, mainline, mainline_ref, fetch_policy, prefetch_status):
    # Shared fetch-verdict + mainline-resolve leg (strict G4 + the marker
    # arm; M2). P2-1(b): the network fetch already ran in track's
    # pre-fetch phase (pre-lock, at most once per (repo,ref) per tick);
    # here we only consume its recorded verdict -- a pre-fetch failure, or
    # a missing verdict for this repo (fail-closed), surfaces fetch-failed
    # and refs resolve locally only. Returns (mainline_sha, None) on
    # success, (None, reason) on failure.
    if fetch_policy == "fetch":
        if tr_parse_fetch_ref(mainline, mainline_ref) is None:
            return None, "mainline-ref-missing"
        if prefetch_status != "ok":
            return None, "fetch-failed"
    rc, mainline_sha, _ = run(["rev-parse", "--verify", "--end-of-options", mainline_ref + "^{commit}"])
    if rc != 0:
        return None, "mainline-ref-missing"
    return mainline_sha.strip(), None


def tr_g4_check(repo_path, mainline, mainline_ref, fetch_policy, base_sha, result_sha, branch, prefetch_status):
    # Returns reason string, or None on full G4 pass. STRICT topology only
    # (B2.1) -- no patch-id / git cherry / content-equivalence, ever.
    # LOCAL-ONLY under the lock: never fetches (P2-1(b)) -- for
    # fetch-policy repos it consumes the pre-lock pre-fetch phase's
    # verdict (prefetch_status) instead. `branch` is the dispatch's own
    # recorded branch, used by the P2-2 result-binding gate below.
    if not mainline_ref or not isinstance(mainline_ref, str):
        return "mainline-ref-not-configured"
    if not mainline_ref.startswith("refs/"):
        return "mainline-ref-missing"
    if fetch_policy not in ("fetch", "local-only"):
        # The design doc's surface-reason enumeration has no distinct token
        # for "invalid fetch_policy value"; bucketed with the adjacent
        # not-configured reason (same remediation: fix .pm/config.json).
        return "mainline-ref-not-configured"

    def run(args, timeout=10):
        # P3-2: pure delegate to tr_run -- the single home of the git env
        # policy (GIT_ENV_SCRUB + GIT_NO_REPLACE_OBJECTS), never a second
        # env-building copy.
        return tr_run(args, repo_path, timeout=timeout)

    rc, obj_format, _ = run(["rev-parse", "--show-object-format"])
    if rc != 0:
        return "unreachable"
    obj_format = obj_format.strip()

    if tr_repo_has_grafts(repo_path):
        return "replace-affected"

    reason, _ = tr_verify_commit(repo_path, result_sha, obj_format)
    if reason:
        return reason
    reason, _ = tr_verify_commit(repo_path, base_sha, obj_format)
    if reason:
        return reason

    if result_sha == base_sha:
        return "result==base"

    rc, _, _ = run(["merge-base", "--is-ancestor", "--end-of-options", base_sha, result_sha])
    if rc != 0:
        return "result-not-descendant-of-base"

    # P2-2: bind result_sha to the dispatch's OWN recorded branch -- the
    # same strict binding stage-1 intake's tr_corroborate_git enforces
    # (there: result_sha IS the branch tip by construction; here: branch
    # tip == result_sha, or result_sha is an ancestor of the branch tip,
    # i.e. the commit actually lived on that branch). Without this, ANY
    # already-merged commit descending from base (e.g. the mainline tip
    # itself) satisfies pure topology and a forged `result` + human VERIFY
    # would false-close. A missing/deleted/unresolvable branch is
    # fail-closed the same way -- surface, never close.
    if not branch or not isinstance(branch, str):
        return "result-not-bound-to-branch"
    if tr_branch_binding_state(run, result_sha, branch) != "bound":
        return "result-not-bound-to-branch"

    mainline_sha, reason = tr_resolve_mainline(
        run, mainline, mainline_ref, fetch_policy, prefetch_status
    )
    if reason:
        return reason

    rc, _, _ = run(["merge-base", "--is-ancestor", "--end-of-options", result_sha, mainline_sha])
    if rc != 0:
        return "no-strict-ancestry-and-no-valid-marker"

    return None


# B2.2: the ONLY strict-G4 failure reasons the marker arm may take over --
# the final topology legs (base-ancestor / mainline-ancestor) plus the
# branch-binding leg (which the marker arm RE-RUNS itself, with the
# explicit branch-deleted opt-out; it is never waived). Every other strict
# failure (config shape, unreachable repo, graft/replace suspicion,
# sha-malformed, fetch-failed, result==base, ...) surfaces as-is: the
# marker corroborates topology, nothing else.
MARKER_ELIGIBLE_STRICT_FAILURES = frozenset({
    "result-not-descendant-of-base",
    "result-not-bound-to-branch",
    "no-strict-ancestry-and-no-valid-marker",
})


def tr_g4_marker_check(repo_path, mainline, mainline_ref, fetch_policy, base_sha,
                       att_result, branch, prefetch_status, marker, allow_branch_deleted):
    # B2.2 G4 marker arm -- consulted ONLY for merge_mode=squash repos and
    # ONLY after strict G4 failed with a MARKER_ELIGIBLE_STRICT_FAILURES
    # reason. Returns (close_mode, None) on full pass -- close_mode is
    # "auto-closed-marker" or "auto-closed-marker-branch-deleted" -- else
    # (None, reason).
    #
    # TRUTHFUL FRAMING (fix-pass-6 F6): a marker close is HUMAN ATTESTATION
    # sanity-checked by git, NOT git corroboration that the dispatch's work
    # landed. Git verifies only that merge_sha names a real commit on the
    # configured mainline; it CANNOT verify that this commit contains the
    # attempt's work (that is exactly the information squash/rebase
    # destroys). A forged or typo'd marker on a squash repo can therefore
    # close VERIFIED-but-unmerged work. The compensating controls are: the
    # double opt-in (automation.auto_close AND merge_mode=squash, plus
    # allow_marker_branch_deleted for the laxest variant), the human VERIFY
    # gate upstream (G2), and the durable auto-close:* audit note emitted
    # BEFORE the close.
    #
    # This function does NOT re-run strict G4's config-shape guards
    # (mainline_ref/fetch_policy shape): its safety against being invoked
    # on a config-shaped failure rests on MARKER_ELIGIBLE_STRICT_FAILURES
    # excluding every config reason -- keep that set and this constraint in
    # lockstep. It DOES re-run the repo-level guards (object format, graft
    # probe) and identity-anchors both shas it consumes. Everything here is
    # LOCAL-only under the lock, via tr_run's env policy (GIT_ENV_SCRUB +
    # GIT_NO_REPLACE_OBJECTS); the fetch verdict is consumed from the
    # pre-lock prefetch phase exactly like strict G4.
    def run(args, timeout=10):
        return tr_run(args, repo_path, timeout=timeout)

    rc, obj_format, _ = run(["rev-parse", "--show-object-format"])
    if rc != 0:
        return None, "unreachable"
    obj_format = obj_format.strip()

    if tr_repo_has_grafts(repo_path):
        return None, "replace-affected"

    # fix-pass-6 F4: att_result is a cross-function input (the fold's
    # per-attempt result, selected by the caller) -- identity-anchor it
    # here rather than trusting the caller's sequencing to have verified
    # it. Reuses the strict sha-verification reason tokens.
    reason, _ = tr_verify_commit(repo_path, att_result, obj_format)
    if reason:
        return None, reason

    # fix-pass-6 F2: zero-new-work re-check. The marker path deliberately
    # skips base-ANCESTRY (squash rewrites it away), but a result equal to
    # its base means no work at all -- refuse in-arm, independently of the
    # eligible-set exclusion of "result==base".
    if att_result == base_sha:
        return None, "result==base"

    # marker shape + fold-result agreement. The fold already refused any
    # marker whose result_sha disagreed with the recorded (d, a) result,
    # so a mismatch here means a corrupted/hand-edited index -- surface.
    merge_sha = marker.get("merge_sha") if isinstance(marker, dict) else None
    marker_result = marker.get("result_sha") if isinstance(marker, dict) else None
    if not merge_sha or not marker_result:
        return None, "no-strict-ancestry-and-no-valid-marker"
    if marker_result != att_result:
        return None, "marker-mismatch"

    reason, _ = tr_verify_commit(repo_path, merge_sha, obj_format)
    if reason:
        return None, "marker-merge-sha-unverified"

    # C2 fix: nothing above ties merge_sha to THIS dispatch's base_sha --
    # marker_result==att_result only binds merge_sha's sibling field
    # (marker.result_sha), and "merge_sha is verified + is an ancestor of
    # mainline" is trivially true for ANY old commit already in mainline's
    # history, including one that predates this dispatch's base entirely
    # (e.g. a stale/forged/hand-edited marker pointing at some earlier,
    # unrelated squash-merge that landed before this dispatch was even cut).
    # Refuse when merge_sha is that base_sha itself, or already an ancestor
    # of it -- i.e. the "merge" provably happened at-or-before this
    # dispatch's base, so it cannot be evidence of THIS dispatch's work.
    #
    # Deliberately NOT the mirror check (requiring base_sha to be an
    # ancestor of merge_sha): a dispatch's recorded base_sha need not sit on
    # mainline's ancestry line at all -- e.g. section_ac_marker_via_not_
    # descendant legitimately records a base_sha that is a sibling of the
    # squash-merged result (same shape as strict G4's own
    # result-not-descendant-of-base tolerance), and the marker arm exists
    # precisely to still close those via human attestation. Requiring
    # forward ancestry from base_sha would wrongly refuse that legitimate
    # case; checking only "did merge_sha predate/coincide with base_sha" is
    # the actual C2 attack shape and leaves that legitimate case untouched.
    if merge_sha == base_sha:
        return None, "marker-merge-predates-dispatch"
    rc, _, _ = run(["merge-base", "--is-ancestor", "--end-of-options", merge_sha, base_sha])
    if rc == 0:
        return None, "marker-merge-predates-dispatch"

    # BRANCH-BINDING IS NOT WAIVED: if the dispatch's recorded branch still
    # resolves, the result MUST be bound to it exactly as in strict G4. A
    # branch that no longer resolves (normal post-squash cleanup) permits a
    # close ONLY under the repo's explicit allow_marker_branch_deleted
    # opt-in; otherwise surface.
    close_mode = "auto-closed-marker"
    if not branch or not isinstance(branch, str):
        return None, "result-not-bound-to-branch"
    binding = tr_branch_binding_state(run, att_result, branch)
    if binding == "unbound":
        return None, "result-not-bound-to-branch"
    if binding == "absent":
        if not allow_branch_deleted:
            return None, "marker-branch-absent-uncorroborated"
        close_mode = "auto-closed-marker-branch-deleted"

    mainline_sha, reason = tr_resolve_mainline(
        run, mainline, mainline_ref, fetch_policy, prefetch_status
    )
    if reason:
        return None, reason

    rc, _, _ = run(["merge-base", "--is-ancestor", "--end-of-options", merge_sha, mainline_sha])
    if rc != 0:
        return None, "marker-merge-not-on-mainline"

    return close_mode, None


def evaluate_issue(issue_id, index, repos, dispatch_issue_map, auto_close_enabled, archive_leftovers, prefetch):
    # Returns (action, reason): action in {"close", "rearchive", "surface",
    # "skip"}. "skip" = steady-state CLOSED, nothing to do, no TRACKER.md
    # row at all. "rearchive" is ALWAYS attempted regardless of
    # auto_close_enabled (crash recovery finishes an already-decided close,
    # it is not a new close decision). "close"/"surface" are the normal
    # G1-G4 outcomes; when auto_close_enabled is False evaluation STOPS
    # after G3 (P2-1(a)) and surfaces `auto-close-disabled` -- G4 (and any
    # git work) is never run for a disabled tick. `prefetch` is the
    # pre-lock pre-fetch phase's {repo_name: verdict} map (P2-1(b)).
    issues = index.get("issues", {})
    dispatches = index.get("dispatches", {})
    issue = issues.get(issue_id)

    # G1 -----------------------------------------------------------------
    if issue is None:
        return "surface", "issue-unregistered"
    state = issue.get("state")
    if state == "CLOSED":
        if archive_leftovers:
            return "rearchive", "CLOSED-but-archive-leftovers"
        return "skip", None
    if state == "NEEDS-USER":
        return "surface", "NEEDS-USER"
    if state == "BLOCKED":
        return "surface", "BLOCKED"
    if state not in CLOSEABLE_STATES:
        # OPEN / TODO / PARKED / any other non-{ACTIVE,IN-PROGRESS} state.
        return "surface", "paused/non-active"

    # G1.5 -- quarantined events touching this issue -----------------------
    # A quarantined line was rejected by the fold's rule engine, but it can
    # still name real semantic content (an invalid question state on an
    # otherwise-legit issue link, a corrupt issue_state/dispatch_*/result
    # touching this issue or one of its dispatches) that MUST NOT be
    # silently invisible to the close decision -- surface, never close.
    quarantine_reasons = (index.get("quarantine_by_issue", {}) or {}).get(issue_id)
    if quarantine_reasons:
        if REASON_INVALID_QUESTION_STATE in quarantine_reasons:
            return "surface", REASON_INVALID_QUESTION_STATE
        return "surface", REASON_ISSUE_RELATED_QUARANTINE
    if index.get("quarantine_unattributable"):
        # A quarantined line the fold could not cleanly and unambiguously
        # attribute to one issue (a hard grammar failure, a duplicate-key/
        # quoted/trailing-token poison line, or any other reparse-divergent
        # case) could plausibly belong to ANY issue, so block ALL closeable
        # issues this tick rather than risk closing the one it was meant
        # for -- or, worse, letting a poisoned dispatch<->issue join close
        # the wrong issue outright (Codex-sparred defect, round 2).
        return "surface", "quarantine-unattributable-blocks-autoclose"

    # G2 -----------------------------------------------------------------
    open_by_issue = index.get("open_questions_by_issue", {}) or {}
    if open_by_issue.get(issue_id):
        return "surface", "open-question-for-issue"
    if index.get("open_questions_unscoped"):
        return "surface", "open-question-unscoped"

    # G3 -----------------------------------------------------------------
    my_dispatch_ids = [d for d, i in dispatch_issue_map.items() if i == issue_id]
    non_superseded = [
        d for d in my_dispatch_ids if not (dispatches.get(d) or {}).get("superseded")
    ]
    if not non_superseded:
        return "surface", "no-non-superseded-dispatch"

    # successor_of[d] = the dispatch that named `d` via `supersedes=`.
    successor_of = {}
    for d, disp in dispatches.items():
        sup = disp.get("supersedes")
        if sup:
            successor_of[sup] = d

    for d in my_dispatch_ids:
        disp = dispatches.get(d) or {}
        if not disp.get("superseded"):
            continue
        succ = successor_of.get(d)
        succ_issue = dispatch_issue_map.get(succ) if succ else None
        if succ_issue is not None and succ_issue != issue_id:
            return "surface", "superseded-by-other-issue"

    # Cross-issue child_of roll-up: ANY dispatch ANYWHERE in the full
    # descendant graph of one of I's dispatches (not just direct children --
    # grandchildren, great-grandchildren, ...) that is still active
    # (non-terminal) blocks I's close, regardless of which issue that
    # descendant dispatch itself belongs to (ledger-check enforces this
    # roll-up globally, not per-issue). Walk the transitive closure via a
    # children_of adjacency built from the WHOLE dispatch set, with a
    # visited-set guard against cycles.
    children_of = {}
    for d, disp in dispatches.items():
        parent = disp.get("child_of")
        if parent:
            children_of.setdefault(parent, []).append(d)

    visited = set()
    stack = list(my_dispatch_ids)
    while stack:
        cur = stack.pop()
        for child in children_of.get(cur, []):
            if child in visited:
                continue
            visited.add(child)
            child_disp = dispatches.get(child) or {}
            if child_disp.get("state") not in TERMINAL_DISPATCH_STATES:
                return "surface", "parent/child-roll-up-violation"
            stack.append(child)

    verified = []
    for d in non_superseded:
        disp = dispatches.get(d) or {}
        dstate = disp.get("state")
        if dstate == "VERIFIED":
            verified.append(d)
            continue
        if dstate == "ABANDONED":
            succ = successor_of.get(d)
            succ_issue = dispatch_issue_map.get(succ) if succ else None
            has_same_issue_successor = False
            if succ_issue == issue_id:
                has_same_issue_successor = True
            else:
                for d2, disp2 in dispatches.items():
                    if disp2.get("child_of") == d and dispatch_issue_map.get(d2) == issue_id:
                        has_same_issue_successor = True
                        break
            if not has_same_issue_successor:
                return "surface", "ABANDONED-without-same-issue-successor"
            continue
        if dstate == "FAILED":
            return "surface", "FAILED"
        if dstate == "QUARANTINED":
            return "surface", "QUARANTINED"
        return "surface", "dispatch-not-VERIFIED"

    if not verified:
        # Every non-superseded dispatch was ABANDONED-with-successor; none
        # left to G4-corroborate. Treat as "no work to corroborate a close
        # against" -- conservatively surface rather than close on nothing.
        return "surface", "no-non-superseded-dispatch"

    # P2-1(a): with automation.auto_close OFF, stop HERE -- before G4.
    # `auto-close-disabled` means "G1-G3 passed; G4 corroboration was NOT
    # run because the flag is off" (an informative candidate list, not a
    # fully-corroborated one). An OFF tick performs zero git/network work
    # for its candidates by construction.
    if not auto_close_enabled:
        return "surface", "auto-close-disabled"

    # G4 -----------------------------------------------------------------
    close_modes = set()
    for d in verified:
        disp = dispatches.get(d) or {}
        repo_name = disp.get("repo")
        branch = disp.get("branch")
        # fix-pass-5b#1: `branch` here is read straight from the index
        # (disp.get("branch")), not re-derived from anything F1 already
        # validated at ACK-recording time. A corrupted/forged index entry
        # would otherwise let an arbitrary, non-ticket-convention branch
        # name build refs/heads/<branch> and silently satisfy the P2-2
        # binding check below. Mirror F1's own TICKET_RE shape gate here,
        # fail-closed, before that ref is ever built.
        if not branch or not TICKET_RE.match(branch):
            return "surface", "result-not-bound-to-branch"
        repo_entry = repos.get(repo_name) if repo_name else None
        repo_path = repo_entry.get("path") if repo_entry else None
        if not repo_path:
            return "surface", "repo-not-configured"
        # B2.2 marker-path opt-ins: runtime fail-closed validation (config
        # is operator-editable post-scaffold; scaffold-time validity is
        # never trusted). Absent keys mean the defaults ("merge" / false)
        # so generated repos predating B2.2 keep working; anything else
        # invalid surfaces for this repo's issues rather than guessing.
        merge_mode = repo_entry.get("merge_mode")
        if merge_mode is None:
            merge_mode = "merge"
        allow_marker_branch_deleted = repo_entry.get("allow_marker_branch_deleted")
        if allow_marker_branch_deleted is None:
            allow_marker_branch_deleted = False
        if merge_mode not in ("merge", "squash") or not isinstance(allow_marker_branch_deleted, bool):
            return "surface", "repo-config-invalid"
        rc, _, _ = tr_run(["rev-parse", "--is-inside-work-tree"], repo_path)
        if rc != 0:
            return "surface", "repo-not-on-disk"

        attempt = disp.get("attempt")
        base_sha = ((disp.get("attempts") or {}).get(attempt) or {}).get("base_sha")
        result_sha = disp.get("result_sha")
        if not base_sha or not result_sha:
            return "surface", "missing-repo-metadata"

        mainline = repo_entry.get("mainline")
        mainline_ref = repo_entry.get("mainline_ref")
        fetch_policy = repo_entry.get("fetch_policy")
        reason = tr_g4_check(repo_path, mainline, mainline_ref, fetch_policy,
                             base_sha, result_sha, branch, prefetch.get(repo_name))
        if reason is None:
            # strict topology corroborated -- squash repos included (fast-
            # forward / merge-commit cases still close strictly).
            close_modes.add("auto-closed-strict")
            continue
        if merge_mode != "squash" or reason not in MARKER_ELIGIBLE_STRICT_FAILURES:
            return "surface", reason

        # B2.2 marker arm: strict topology failed on a squash-workflow
        # repo -- consult the fold-accepted, human-attested `merged`
        # marker for THIS dispatch's current attempt. The marker's
        # result_sha is validated against the per-attempt fold result
        # (never the dispatch-level last-write-wins value).
        att_result = ((disp.get("attempts") or {}).get(attempt) or {}).get("result_sha")
        if not att_result:
            return "surface", "missing-repo-metadata"
        marker = (disp.get("merged") or {}).get(attempt)
        if not isinstance(marker, dict):
            return "surface", "no-strict-ancestry-and-no-valid-marker"
        close_mode, mreason = tr_g4_marker_check(
            repo_path, mainline, mainline_ref, fetch_policy, base_sha, att_result,
            branch, prefetch.get(repo_name), marker, allow_marker_branch_deleted,
        )
        if mreason:
            return "surface", mreason
        close_modes.add(close_mode)

    # Close-mode legibility: the row's reason records HOW the close was
    # corroborated. If ANY dispatch needed the marker path, the row says
    # so (the branch-deleted variant wins for explicitness); a pure-strict
    # close says auto-closed-strict.
    if "auto-closed-marker-branch-deleted" in close_modes:
        return "close", "auto-closed-marker-branch-deleted"
    if "auto-closed-marker" in close_modes:
        return "close", "auto-closed-marker"
    return "close", "auto-closed-strict"
PYEOF

# ---------------------------------------------------------------------------
# Auto-close pre-fetch phase (P2-1(b)) -- STILL OUTSIDE the lock, right
# before acquiring it: the ONLY network work the auto-close pass ever does.
# Fetches each configured fetch-policy repo's mainline ref at most once per
# (repo,ref) per tick and records a per-repo verdict; stage 2.5's G4 then
# resolves refs LOCALLY under the lock and consumes the verdict (a
# pre-fetch failure surfaces `fetch-failed` for the issues that need that
# repo). Skipped entirely when automation.auto_close is OFF -- a disabled
# tick performs zero fetches (P2-1(a)). A driver failure degrades to an
# empty verdict map, which G4 reads as fetch-failed for every fetch-policy
# repo (fail-closed, never fail-open).
# ---------------------------------------------------------------------------
_tr_autoclose_prefetch() {
_tr_prefetch_file="$(_tr_mktemp "${TMPDIR:-/tmp}/pm-track-ac-prefetch.XXXXXX")"
printf '{}' >"${_tr_prefetch_file}"
if [[ "${_tr_auto_close_enabled}" == "1" ]]; then
  _tr_prefetch_driver='
import json, os

_pf_repos = json.loads(os.environ["PM_TR_REPOS"])
_pf_out = os.environ["PM_TR_PREFETCH_OUT"]
_pf_status = tr_prefetch_mainline_refs(_pf_repos)
with open(_pf_out, "w") as f:
    json.dump(_pf_status, f)
'
  if ! PM_TR_REPOS="${_tr_repos_json}" \
    PM_TR_PREFETCH_OUT="${_tr_prefetch_file}" \
    bash -c 'printf "%s\n%s\n%s\n" "$1" "$2" "$3" | python3 -' _ "${_TR_CORROB_PY}" "${_TR_CLOSE_PY}" "${_tr_prefetch_driver}"; then
    printf '{}' >"${_tr_prefetch_file}"
  fi
fi
}

# ---------------------------------------------------------------------------
# STAGE 2.5 (still under the SAME pm_lock hold, after the RETURNED-intake
# apply loop above): B2.1 auto-close pass, STRICT merged-path only (the
# MARKER path is B2.2, not built here). index.json is already fresh here --
# pm_apply/pm_apply_batch refolds it on every successful write above, so no
# extra pm_fold call is needed. Config-gated on automation.auto_close
# (_tr_auto_close_enabled, default OFF): when OFF, every issue that passes
# G1-G3 is surfaced as `auto-close-disabled` -- meaning "G1-G3 passed; G4
# corroboration was NOT run because the flag is off" (P2-1(a)) -- an
# informative candidate list; nothing is ever closed, and no git/network
# work runs, with the flag off.
# Crash-recovery re-archiving (CLOSED issue with leftover prompts/messages
# files) is ALWAYS attempted regardless of the flag: it completes an
# already-decided close, not a new close decision.
#
# This pass is a pure function of index.json + .pm/config.json + live git --
# the herdr snapshot (_tr_snapshot_file / _tr_herdr_ok) is NEVER read here,
# by construction, so a herdr-unavailable tick still auto-closes normally.
# ---------------------------------------------------------------------------
_tr_autoclose_pass() {
_tr_ac_verdict_file="$(_tr_mktemp "${TMPDIR:-/tmp}/pm-track-ac-verdict.XXXXXX")"
_tr_ac_driver='
import json, os, traceback

_ac_index_path = os.environ["PM_TR_INDEX"]
_ac_root = os.environ["PM_TR_ROOT"]
_ac_auto_close = os.environ["PM_TR_AUTO_CLOSE"] == "1"
_ac_out_path = os.environ["PM_TR_AC_OUT"]

with open(_ac_index_path) as f:
    _ac_index = json.load(f)
_ac_repos = json.loads(os.environ["PM_TR_REPOS"])
# Pre-lock pre-fetch verdicts (P2-1(b)); unreadable/absent degrades to {}
# -> G4 treats every fetch-policy repo as fetch-failed (fail-closed).
try:
    with open(os.environ["PM_TR_PREFETCH"]) as f:
        _ac_prefetch = json.load(f)
except Exception:
    _ac_prefetch = {}
if not isinstance(_ac_prefetch, dict):
    _ac_prefetch = {}

# Authoritative dispatch_new -> issue map, fold-derived (index.json key
# "dispatch_issue_map", built ONLY from ACCEPTED -- successfully-applied,
# never quarantined -- dispatch_new events; P3-5). NEVER a second raw-log
# re-scan of the event log.
# A raw re-parse here would diverge from the strict grammar the fold
# itself uses (e.g. accepting a duplicate-key line the fold quarantined)
# and could misattribute a dispatch to the wrong issue, closing it in
# error.
_ac_dispatch_issue_map = dict(_ac_index.get("dispatch_issue_map") or {})

_ac_issue_ids = set(_ac_index.get("issues", {}).keys())
_ac_issue_ids.update(_ac_dispatch_issue_map.values())

def _ac_has_leftovers(issue_id):
    # P3-6: an OSError here (unreadable prompts/ or messages/) must NOT be
    # read as "no leftovers" -- it deliberately PROPAGATES to the per-issue
    # handler below and surfaces auto-close-driver-error with the traceback
    # as detail. A silently-swallowed False would skip crash-recovery
    # re-archiving for a CLOSED issue forever, with no trace anywhere.
    for sub in ("prompts", "messages"):
        d = os.path.join(_ac_root, sub)
        if not os.path.isdir(d):
            continue
        prefix = issue_id + "_"
        for name in os.listdir(d):
            if name.startswith(prefix):
                return True
    return False

_ac_results = []
for _ac_i in sorted(_ac_issue_ids):
    # Never let a single unexpected exception on this issue (bad/malformed
    # config values, corrupt index data, ...) crash the WHOLE auto-close
    # pass -- that would silently leave every OTHER issue with no verdict
    # at all (Codex-sparred defect #3). Surface a loud, attributable
    # reason for just this issue and keep going.
    try:
        _ac_action, _ac_reason = evaluate_issue(
            _ac_i, _ac_index, _ac_repos, _ac_dispatch_issue_map,
            _ac_auto_close, _ac_has_leftovers(_ac_i), _ac_prefetch,
        )
        # fix-pass-5b#3: REASONS is the single registry of every surface
        # reason token this pass may emit. Enforce it here rather than let
        # it silently drift from what evaluate_issue actually returns --
        # an unregistered token would otherwise flow straight into the
        # verdict row unexamined. Reuses the existing per-issue
        # crash-isolation path below (loud, attributable, never crashes
        # the whole pass).
        if _ac_reason is not None and _ac_reason not in REASONS:
            raise ValueError(
                f"unregistered auto-close reason token: {_ac_reason!r} "
                f"(action={_ac_action!r}) -- REASONS registry has drifted; "
                "add it to REASONS in track"
            )
        _ac_detail = None
    except Exception:
        _ac_action, _ac_reason = "surface", "auto-close-driver-error"
        # P3-3(a): the surfaced row carries a bounded traceback as detail
        # -- attributable diagnostics, never a bare opaque reason.
        _ac_detail = traceback.format_exc()[-2000:]
    if _ac_action == "skip":
        continue
    _ac_row = {"i": _ac_i, "action": _ac_action, "reason": _ac_reason}
    if _ac_detail:
        _ac_row["detail"] = _ac_detail
    _ac_results.append(_ac_row)

with open(_ac_out_path, "w") as f:
    json.dump(_ac_results, f)
'
# Default to a valid-but-empty verdict file BEFORE invoking the driver, so
# a total driver crash (before it ever gets to write PM_TR_AC_OUT itself --
# e.g. an exception outside the per-issue try/except above) still leaves
# behind parseable JSON rather than a missing/truncated file.
printf '[]' >"${_tr_ac_verdict_file}"
_tr_ac_driver_stderr_file="$(_tr_mktemp "${TMPDIR:-/tmp}/pm-track-ac-driver-err.XXXXXX")"
_tr_ac_driver_ok=1
if ! PM_TR_INDEX="${_tr_index}" \
  PM_TR_REPOS="${_tr_repos_json}" \
  PM_TR_ROOT="${_tr_root}" \
  PM_TR_AUTO_CLOSE="${_tr_auto_close_enabled}" \
  PM_TR_PREFETCH="${_tr_prefetch_file}" \
  PM_TR_AC_OUT="${_tr_ac_verdict_file}" \
  bash -c 'printf "%s\n%s\n%s\n" "$1" "$2" "$3" | python3 -' _ "${_TR_CORROB_PY}" "${_TR_CLOSE_PY}" "${_tr_ac_driver}" \
  2>"${_tr_ac_driver_stderr_file}"; then
  _tr_ac_driver_ok=0
fi
# Belt-and-suspenders on top of the per-issue try/except above (defect #3):
# even a nonzero exit AND/OR an unparseable verdict file must never be a
# silent no-op -- degrade to one loud, unmistakable surfaced row rather
# than leaving ac_closed/ac_surfaced both empty with no trace anywhere.
if [[ "${_tr_ac_driver_ok}" -eq 1 ]]; then
  if ! python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        json.load(f)
except Exception:
    sys.exit(1)
' "${_tr_ac_verdict_file}"; then
    _tr_ac_driver_ok=0
  fi
fi
if [[ "${_tr_ac_driver_ok}" -eq 0 ]]; then
  # P3-3(b): a whole-driver crash must never discard its only diagnostics
  # -- the driver's bounded stderr tail is (1) echoed to track's own
  # stderr and (2) embedded as the fallback row's detail, BEFORE the temp
  # stderr file is removed below.
  _tr_ac_err_tail="$(tail -c 2000 "${_tr_ac_driver_stderr_file}" 2>/dev/null || true)"
  if [[ -n "${_tr_ac_err_tail}" ]]; then
    {
      echo "track: auto-close driver failed; stderr tail:"
      printf '%s\n' "${_tr_ac_err_tail}"
    } >&2
  fi
  if ! python3 -c '
import json, sys
row = {"i": "(auto-close)", "action": "surface", "reason": "auto-close-driver-error"}
if sys.argv[2]:
    row["detail"] = sys.argv[2]
with open(sys.argv[1], "w") as f:
    json.dump([row], f)
' "${_tr_ac_verdict_file}" "${_tr_ac_err_tail}"; then
    printf '[{"i": "(auto-close)", "action": "surface", "reason": "auto-close-driver-error"}]' >"${_tr_ac_verdict_file}"
  fi
fi
rm -f "${_tr_ac_driver_stderr_file}"

_tr_ac_closed_file="$(_tr_mktemp "${TMPDIR:-/tmp}/pm-track-ac-closed.XXXXXX")"
_tr_ac_surfaced_file="$(_tr_mktemp "${TMPDIR:-/tmp}/pm-track-ac-surfaced.XXXXXX")"
printf '[]' >"${_tr_ac_closed_file}"
printf '[]' >"${_tr_ac_surfaced_file}"

python3 -c '
import json, sys
with open(sys.argv[1]) as f:
    rows = json.load(f)
for row in rows:
    print(json.dumps(row))
' "${_tr_ac_verdict_file}" | {
  while IFS= read -r _tr_ac_line; do
    [[ -z "${_tr_ac_line}" ]] && continue
    _tr_ac_i="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["i"])' "${_tr_ac_line}")"
    _tr_ac_action="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["action"])' "${_tr_ac_line}")"
    if [[ "${_tr_ac_action}" == "surface" ]]; then
      python3 -c '
import json, sys
path = sys.argv[1]
row = json.loads(sys.argv[2])
with open(path) as f:
    rows = json.load(f)
rows.append(row)
with open(path, "w") as f:
    json.dump(rows, f)
' "${_tr_ac_surfaced_file}" "${_tr_ac_line}"
      continue
    fi
    # action in {close, rearchive}: both invoke pm_close_issue IN-PROCESS
    # (never `bin/close` -- a subprocess acquiring pm_lock while this shell
    # already holds it would deadlock; pm_lock's reentrancy is in-process
    # only). Failures are classified via pm_close_issue's STABLE stderr
    # tokens (P3-4), never by prose matching:
    #   close-refused-state-race     -> close-race/refusal (BENIGN: the
    #                                   issue's state changed under us)
    #   close-refused-unfoldable-log -> close-refused-unfoldable-log
    #                                   (LOUD -- the log itself is sick)
    #   close-transition-durable     -> the CLOSED event IS durably on the
    #                                   log; only archive/note failed ->
    #                                   counted closed, rendered
    #                                   closed-with-pending-archive
    #   anything else                -> close/archive-failure
    # B2.2 (fix-pass-6 F1): a MARKER-path close leaves a durable audit
    # note on the event log (`note ref=auto-close:marker[-branch-deleted]
    # i=<issue>`), so the human-attested corroboration mode survives
    # beyond TRACKER.md's per-tick re-render. Ordering is load-bearing:
    # the note is emitted BEFORE pm_close_issue, so a crash between the
    # two leaves an un-closed issue WITH its provenance record -- the next
    # tick re-evaluates the gates, the fold-derived dedup below skips the
    # re-emit, and the close proceeds (exactly one note total). Emission
    # failure REFUSES the close (fail-closed: no marker close without its
    # durable provenance record) and surfaces marker-note-emit-failed for
    # a retry next tick. Strict closes stay note-free (byte-identical
    # B2.1 behavior).
    if [[ "${_tr_ac_action}" == "close" ]]; then
      _tr_ac_mode="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("reason") or "")' "${_tr_ac_line}")"
      _tr_ac_note_ref=""
      case "${_tr_ac_mode}" in
        auto-closed-marker) _tr_ac_note_ref="auto-close:marker" ;;
        auto-closed-marker-branch-deleted) _tr_ac_note_ref="auto-close:marker-branch-deleted" ;;
      esac
      if [[ -n "${_tr_ac_note_ref}" ]]; then
        # Dedup against the FOLD (index.auto_close_notes, folded at tick
        # start) -- never a raw-log re-scan. A prior crashed tick's note
        # is found here; this tick's own fresh emission cannot be (the
        # re-fold happens next tick), which is exactly right: emit at most
        # once per tick, skip when a durable record already exists.
        _tr_ac_note_dup="$(NOTE_I="${_tr_ac_i}" NOTE_REF="${_tr_ac_note_ref}" python3 -c '
import json, os, sys
try:
    with open(sys.argv[1]) as f:
        idx = json.load(f)
except Exception:
    print("0"); raise SystemExit
refs = (idx.get("auto_close_notes") or {}).get(os.environ["NOTE_I"]) or []
print("1" if os.environ["NOTE_REF"] in refs else "0")
' "${_tr_root}/.pm/index.json")"
        if [[ "${_tr_ac_note_dup}" != "1" ]]; then
          if ! PM_ROOT="${_tr_root}" pm_apply note at="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            ref="${_tr_ac_note_ref}" i="${_tr_ac_i}" >/dev/null 2>&1; then
            python3 -c '
import json, sys
path = sys.argv[1]
row = json.loads(sys.argv[2])
row["reason"] = "marker-note-emit-failed"
row["detail"] = "audit-note emission failed; marker close refused (retry next tick)"
row["action"] = "surface"
with open(path) as f:
    rows = json.load(f)
rows.append(row)
with open(path, "w") as f:
    json.dump(rows, f)
' "${_tr_ac_surfaced_file}" "${_tr_ac_line}"
            continue
          fi
        fi
      fi
    fi
    _tr_ac_out="$(pm_close_issue "${_tr_root}" "${_tr_ac_i}" 2>&1)"
    _tr_ac_rc=$?
    if [[ "${_tr_ac_rc}" -eq 0 ]]; then
      python3 -c '
import json, sys
path = sys.argv[1]
row = json.loads(sys.argv[2])
with open(path) as f:
    rows = json.load(f)
rows.append(row)
with open(path, "w") as f:
    json.dump(rows, f)
' "${_tr_ac_closed_file}" "${_tr_ac_line}"
    else
      _tr_ac_reason="$(tr_ac_classify_close_failure "${_tr_ac_out}")"
      _tr_ac_dest_file="${_tr_ac_surfaced_file}"
      if [[ "${_tr_ac_reason}" == "closed-with-pending-archive" ]]; then
        # P3-4: the CLOSED transition durably landed; only a later
        # archive/note step failed -> the issue IS closed. Count it in the
        # closed set, flagged, instead of misreporting "not auto-closed".
        _tr_ac_dest_file="${_tr_ac_closed_file}"
      fi
      python3 -c '
import json, sys
path = sys.argv[1]
row = json.loads(sys.argv[2])
row["reason"] = sys.argv[3]
row["detail"] = sys.argv[4]
with open(path) as f:
    rows = json.load(f)
rows.append(row)
with open(path, "w") as f:
    json.dump(rows, f)
' "${_tr_ac_dest_file}" "${_tr_ac_line}" "${_tr_ac_reason}" "${_tr_ac_out}"
    fi
  done
}
}
