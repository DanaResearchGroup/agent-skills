#!/usr/bin/env bash
# close — explicit, auditable, idempotent "close a session and archive its
# ephemeral working files" step (event-log-grammar.md §3/§4).
#
# This is a TEMPLATE file: it is copied verbatim into a generated PM repo's
# `bin/` directory and run from that repo's root. Standalone entrypoint,
# bash + python3 only (no jq).
#
# `close` is the explicit, human-gated close-and-archive step: it transitions
# an issue to CLOSED and then archives the issue's ephemeral working files
# (`prompts/`, `messages/`) into `archive/`. `reports/` is never touched —
# reports are the durable artifact, not ephemeral working state.
#
# This script is a thin arg-parsing/root-resolution wrapper: the entire
# close-and-archive core lives in `_lib.sh`'s `pm_close_issue`, a sourceable,
# in-process, lock-reentrant function (see its doc comment). That is what
# lets a future `bin/track` auto-close pass — which already holds `pm_lock`
# — call the same core in-process without deadlocking on a subprocess
# waiting for a lock its own parent holds. `close`'s own behavior (idempotent,
# dry-runnable, refuses unknown issues) is load-bearing beyond just
# interactive use.
#
# NOTE (FIX-D, in-process refactor): the pre-refactor `close` shelled out to
# `record`/`note`, so its stdout also carried those subprocesses' own
# `record: I-### <from> -> CLOSED` / `record: note ...` echo lines. The
# in-process `pm_close_issue` core intentionally drops that subprocess
# chatter (cleaner, single source of truth) while preserving every
# `close:`-prefixed outcome line. Confirmed nothing downstream (reconcile,
# track, scaffold, tests) parses those old `record:` lines from `close`'s
# stdout, so this is a deliberate, safe behavior change, not a regression.
#
# Usage:
#   close <I-###> [--dry-run]
#
# Semantics:
#   - Refuses (exit 1) if the issue was never registered (no prior
#     issue_state event) — you cannot close what was never opened.
#   - Transitions the issue to CLOSED, unless it is already CLOSED
#     (idempotent: skip the transition silently and proceed straight to
#     archiving).
#   - Archives every file in `prompts/` and `messages/` whose basename
#     starts with `<I-###>_` into `archive/prompts/` and `archive/messages/`
#     respectively. Already-archived files (same basename already present at
#     the destination) are skipped with a warning, never clobbered.
#   - `--dry-run` prints what would happen (close + archive moves) without
#     emitting any event or moving any file.
#   - Emits a `note --ref archived:<I-###>` event for the audit trail if the
#     close transition happened and/or any file was archived.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_lib.sh
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/_lib.sh"

usage() {
  cat <<'EOF'
usage: close <I-###> [--dry-run]

Transitions <I-###> to CLOSED (skipped if already CLOSED) and archives its
ephemeral prompts/ and messages/ files into archive/prompts/ and
archive/messages/. reports/ is never touched.
EOF
}

# ---------------------------------------------------------------------------
# root resolution (mirrors record's local copy of the search, rather than
# reaching into _lib.sh's underscore-prefixed internals)
# ---------------------------------------------------------------------------

_find_root() {
  if [[ -n "${PM_ROOT:-}" ]]; then
    printf '%s\n' "$PM_ROOT"
    return 0
  fi
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.pm" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  echo "close: could not locate .pm/ (searched upward from $PWD; set \$PM_ROOT to override)" >&2
  return 1
}

# ---------------------------------------------------------------------------
# args
# ---------------------------------------------------------------------------

issue_id="${1:-}"
[[ -z "$issue_id" ]] && { usage >&2; exit 2; }
shift || true

dry_run=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    *)
      echo "close: unknown argument '$1'" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ ! "$issue_id" =~ ^I-[0-9]+$ ]]; then
  echo "close: issue id must look like I-### (got '$issue_id')" >&2
  exit 2
fi

root="$(_find_root)" || exit 1

# ---------------------------------------------------------------------------
# delegate the entire close-and-archive core to _lib.sh's pm_close_issue
# ---------------------------------------------------------------------------

if [[ "$dry_run" -eq 1 ]]; then
  pm_close_issue "$root" "$issue_id" --dry-run
else
  pm_close_issue "$root" "$issue_id"
fi
